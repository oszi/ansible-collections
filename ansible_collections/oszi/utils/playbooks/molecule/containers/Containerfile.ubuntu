# Molecule test image, built by the oszi.utils.molecule.build playbook; see _scripts/tests/MOLECULE.md.
FROM docker.io/library/ubuntu:latest

# The apt lists stay in the image; see the image TTL in the build playbook.
# The image ships a stale /run/systemd/container that systemd overwrites without truncating.
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        systemd systemd-sysv dbus python3 python3-apt sudo ca-certificates \
    && apt-get clean \
    && rm -f /run/systemd/container

STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
