# shellcheck shell=sh
# workstation-aliases.sh is ordered after flatpak-aliases.sh (e.g. chromium)
alias o='xdg-open'

if command -v google-chrome >/dev/null 2>&1; then
    alias google-chrome-jitless='google-chrome --js-flags="--jitless"'
    alias google-chrome-x11='google-chrome --ozone-platform=x11'
    if ! command -v chromium >/dev/null 2>&1; then
        alias chromium='google-chrome'
    fi
fi

if command -v chromium >/dev/null 2>&1; then
    alias chromium-jitless='chromium --js-flags="--jitless"'
    alias chromium-x11='chromium --ozone-platform=x11'
fi

if ! command -v gedit >/dev/null 2>&1 && command -v gnome-text-editor >/dev/null 2>&1; then
    alias gedit='gnome-text-editor'
fi

{% set wl_copy_text = 'wl-copy -n -t "text/plain;charset=%s"' | format(locale_charmap | default('utf-8', true) | lower) %}
if [ -n "${WAYLAND_DISPLAY-}" ] && command -v wl-copy >/dev/null 2>&1; then
    alias clip='wl-copy'
    alias clip-text={{ wl_copy_text | quote }}
    alias reclip-text={{ ('wl-paste | ' + wl_copy_text) | quote }}
fi

if command -v ykman >/dev/null 2>&1; then
    _ykman_oath_code() {
        if command -v clip >/dev/null 2>&1; then
            ykman oath accounts code "$@" | tee /dev/stderr | awk '{print $(NF)}' | clip
        else
            ykman oath accounts code "$@"
        fi
    }

    alias ykman-oath-code='_ykman_oath_code'
fi
