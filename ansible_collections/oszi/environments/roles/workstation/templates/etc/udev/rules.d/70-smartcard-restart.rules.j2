# {{ ansible_managed }}
{% set yubikey_vendor_id = "1050" %}
{% set yubikey_product_ids = "0113|0114|0115|0116|0120|0121|0200|0402|0403|0406|0407|0410" %}
# Hidraw nodes of Yubikeys; ATTRS read sysfs, which is already gone on remove.
# The uaccess tag only counts before 73-seat-late.rules, hence the numeric prefix.
ACTION=="add|change", KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="{{ yubikey_vendor_id }}", ATTRS{idProduct}=="{{ yubikey_product_ids }}", TAG+="uaccess", GROUP="plugdev", MODE="0660"
# Hidraw nodes get USB properties from 60-persistent-hidraw.rules only since systemd 258; import them otherwise.
ACTION=="add|change", KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="{{ yubikey_vendor_id }}", ENV{ID_BUS}=="", IMPORT{builtin}="usb_id"

# Hidraw node of the first HID interface of Yubikeys, once per key.
# Interfaces are also re-bound when a key returns from a VM, while the USB device itself stays.
ACTION=="add", KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ENV{ID_VENDOR_ID}=="{{ yubikey_vendor_id }}", ENV{ID_MODEL_ID}=="{{ yubikey_product_ids }}", ENV{ID_USB_INTERFACE_NUM}=="00", RUN+="{{ workstation_local_bin_path }}/smartcard-restart"
# USB device of Yubikeys; properties are read from the udev database, so they also match on remove.
ACTION=="remove", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ENV{ID_VENDOR_ID}=="{{ yubikey_vendor_id }}", ENV{ID_MODEL_ID}=="{{ yubikey_product_ids }}", RUN+="{{ workstation_local_bin_path }}/smartcard-restart"
