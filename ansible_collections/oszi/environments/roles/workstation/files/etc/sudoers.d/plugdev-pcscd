# Ansible managed
# See scripts virsh-usb and yubikey-fix
%plugdev ALL=(ALL:ALL) NOPASSWD: /bin/systemctl stop pcscd.socket pcscd.service
%plugdev ALL=(ALL:ALL) NOPASSWD: /bin/systemctl reset-failed pcscd.socket pcscd.service
%plugdev ALL=(ALL:ALL) NOPASSWD: /bin/systemctl start pcscd.socket
%plugdev ALL=(ALL:ALL) NOPASSWD: /bin/systemctl start pcscd.service
