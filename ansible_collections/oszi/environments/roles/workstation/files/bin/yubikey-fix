#!/bin/bash
# See /etc/sudoers.d/plugdev-pcscd /etc/udev/rules.d/yubikey-fix.rules
set -uo pipefail
set +e

exit_help() {
    echo "${0} [--stop-only] [--start-only] [--status-only]" >&2
    exit 2
}

stop=1
start=1

if [[ -t 0 ]]; then
    status=1
else
    status=0
fi

while [[ $# -gt 0 ]]; do
    case "$1" in
        --stop-only) stop=1; start=0; status=0;;
        --start-only) stop=0; start=1; status=0;;
        --status-only) stop=0; start=0; status=1;;
        *) exit_help;;
    esac
    shift
done

if [[ "$stop" -ne 0 ]]; then
    # Kill all agents as root when triggered by udev.
    # Kill only our own when run as a user.
    killall ssh-agent gpg-agent scdaemon

    # Stop pcscd to release devices, together with its socket. PKCS#11 clients such as gsd-smartcard
    # with opensc re-activate it immediately, and pcscd re-claims the CCID interface.
    if systemctl is-active pcscd.socket pcscd.service >/dev/null 2>&1; then
        sudo systemctl stop pcscd.socket pcscd.service
    fi
fi

if [[ "$start" -ne 0 ]]; then
    sudo systemctl reset-failed pcscd.socket pcscd.service
    if systemctl is-enabled pcscd.socket >/dev/null 2>&1; then
        sudo systemctl start pcscd.socket
    elif systemctl is-enabled pcscd.service >/dev/null 2>&1; then
        sudo systemctl start pcscd.service
    fi
fi

if [[ "$status" -ne 0 ]]; then
    # Delete stuck SSH control sockets.
    find ~/.ssh/ -type s -name '*@*:*' -delete

    # Start services via socket activation.
    gpg --card-status
fi
