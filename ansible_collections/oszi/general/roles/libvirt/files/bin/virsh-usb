#!/bin/bash
set -euo pipefail

if [[ $# -gt 2 ]] || [[ ! "${1-}" =~ ^(at|de)tach$ ]]; then
    echo "Usage: $0 attach|detach [device-regex]" >&2
    exit 2
fi

virsh="virsh -c qemu:///system"
command="$1"
pattern="${2:-.*}"

if ! (command -v virsh && command -v fzf && command -v xmllint) >/dev/null 2>&1; then
    echo "virsh|fzf|xmllint not found" >&2
    exit 127
fi

domains="$(${virsh} list --all --name | sort)"
if [ -z "$domains" ]; then
    echo "${virsh} list --all returned empty" >&2
    exit 1
fi

device=$(
    for device in /sys/bus/usb/devices/*; do
        if grep -Eis -- "$pattern" "${device}/manufacturer" "${device}/product" >/dev/null 2>&1; then
            printf '%s\t%s\t%s\t%s\n' \
                "$device" \
                "$(<"${device}/manufacturer")" \
                "$(<"${device}/product")" \
                "$(cat "${device}/serial" 2>/dev/null ||:)"
        fi
    done | fzf --delimiter=$'\t' --no-multi --no-sort | cut -f1
)

vendor_id="$(cat "${device}/idVendor")"
product_id="$(cat "${device}/idProduct")"
busnum="$((10#$(<"${device}/busnum")))"
devnum="$((10#$(<"${device}/devnum")))"

matching_device_count=0
for usb_device in /sys/bus/usb/devices/*; do
    if [[ -r "${usb_device}/idVendor" && -r "${usb_device}/idProduct" ]] \
        && [[ "$(<"${usb_device}/idVendor")" == "$vendor_id" ]] \
        && [[ "$(<"${usb_device}/idProduct")" == "$product_id" ]]; then
        matching_device_count=$((matching_device_count + 1))
    fi
done

device_address_xml=""
if ((matching_device_count > 1)); then
    device_address_xpath="and source/address[
        number(@bus)=${busnum}
        and number(@device)=${devnum}
    ]"
    device_address_xml="
    <address bus=\"${busnum}\" device=\"${devnum}\"/>"
else
    device_address_xpath="and (
        not(source/address)
        or source/address[
            number(@bus)=${busnum}
            and number(@device)=${devnum}
        ]
    )"
fi

device_xpath="//domain/devices/hostdev[
    @type='usb'
    and source/vendor/@id='0x${vendor_id}'
    and source/product/@id='0x${product_id}'
    ${device_address_xpath}
]"

function virsh_command() {
    local command="$1"
    local domain="$2"

    cat <<EOF | ${virsh} "${command}-device" "$domain" /dev/stdin --current
<hostdev mode="subsystem" type="usb" managed="yes">
  <source>
    <vendor id="0x${vendor_id}"/>
    <product id="0x${product_id}"/>${device_address_xml}
  </source>
</hostdev>
EOF
}

for domain in ${domains}; do
    if ${virsh} dumpxml "$domain" | xmllint --xpath "$device_xpath" - >/dev/null 2>&1; then
        echo -n "Detach ${vendor_id}:${product_id} from ${domain}? [Y/n]" >&2
        read -r answer
        if ! [[ "$answer" =~ ^[Nn] ]]; then
            virsh_command detach "$domain"
        fi
    fi
done

if [[ "$command" == attach ]]; then
    domain="$(echo "$domains" | fzf --no-multi --no-sort --tac)"

    if grep -q Yubi "${device}/manufacturer"; then
        echo "Yubikey must be released by ssh-agent, gpg-agent, scdaemon and pcscd..." >&2
        killall ssh-agent gpg-agent scdaemon ||:
        if systemctl is-active pcscd >/dev/null 2>&1; then
            sudo systemctl stop pcscd ||:
        fi
    fi

    echo "Attaching ${vendor_id}:${product_id} to ${domain}" >&2
    virsh_command attach "$domain"
fi
