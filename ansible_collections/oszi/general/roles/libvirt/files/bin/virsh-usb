#!/bin/bash
set -euo pipefail

virsh=(env LC_ALL=C virsh -c qemu:///system)
command="${1-attach}"

if [[ $# -gt 2 ]] || [[ ! "$command" =~ ^(at|de)tach$ ]]; then
    echo "Usage: $0 [attach|detach] [device-regex]" >&2
    exit 2
fi

if [[ -n "${2-}" ]]; then
    grep_opts=("-Eis")
    pattern="$2"
else
    # Exclude host controllers; manufacturer and product both match [ex]hci.
    grep_opts=("-Evis")
    pattern=$'\\b[ex]hci'
fi

if ! (command -v virsh && command -v fzf && command -v xmllint) >/dev/null 2>&1; then
    echo "virsh|fzf|xmllint not found" >&2
    exit 127
fi

mapfile -t domains < <("${virsh[@]}" list --all --name | grep . | sort)
if [ "${#domains[@]}" -eq 0 ]; then
    echo "${virsh[*]} list --all returned empty" >&2
    exit 1
fi

function cat_sanitized() {
    local content
    content="$(<"$1")"
    printf '%s' "${content//[[:cntrl:]]/}"
}

device=$(
    for device in /sys/bus/usb/devices/*; do
        if grep "${grep_opts[@]}" -- "$pattern" "${device}/manufacturer" "${device}/product" >/dev/null 2>&1; then
            printf '%s\t[bus=%d/dev=%d]\t%s %s\n' \
                "$device" \
                "$((10#$(<"${device}/busnum")))" \
                "$((10#$(<"${device}/devnum")))" \
                "$(cat_sanitized "${device}/manufacturer")" \
                "$(cat_sanitized "${device}/product")"
        fi
    done | sort -t $'\t' -k3 -f | fzf --header="Select one matching USB device." --delimiter=$'\t' \
    --no-multi --no-sort --tac --exact --select-1 --exit-0 | cut -f1
) || {
    echo "No USB device selected that matched: grep ${grep_opts[*]} ${pattern}" >&2
    exit 1
}

vendor_id="$(<"${device}/idVendor")"
product_id="$(<"${device}/idProduct")"
busnum="$((10#$(<"${device}/busnum")))"
devnum="$((10#$(<"${device}/devnum")))"

manufacturer="$(cat_sanitized "${device}/manufacturer")"
product="$(cat_sanitized "${device}/product")"
device_desc="${manufacturer} ${product} [bus=${busnum}/dev=${devnum}]"

function multiple_matching_devices() {
    local device
    local matching_device_count=0

    for device in /sys/bus/usb/devices/*; do
        if [[ -r "${device}/idVendor" && -r "${device}/idProduct" ]] \
            && [[ "$(<"${device}/idVendor")" == "$vendor_id" ]] \
            && [[ "$(<"${device}/idProduct")" == "$product_id" ]]; then
            matching_device_count=$((matching_device_count + 1))
        fi
    done
    ((matching_device_count > 1))
}

if multiple_matching_devices; then
    device_address_xpath="and source/address[
        number(@bus)=${busnum}
        and number(@device)=${devnum}
    ]"
    device_address_xml="
    <address bus=\"${busnum}\" device=\"${devnum}\"/>"
else
    device_address_xpath="and (
        not(source/address)
        or source/address[
            number(@bus)=${busnum}
            and number(@device)=${devnum}
        ]
    )"
    device_address_xml=""
fi

device_xpath="//domain/devices/hostdev[
    @type='usb'
    and source/vendor/@id='0x${vendor_id}'
    and source/product/@id='0x${product_id}'
    ${device_address_xpath}
]"

function virsh_command() {
    local command="${1}-device"
    local domain="$2"

    cat <<EOF | "${virsh[@]}" "$command" "$domain" /dev/stdin --current
<hostdev mode="subsystem" type="usb" managed="yes">
  <source>
    <vendor id="0x${vendor_id}"/>
    <product id="0x${product_id}"/>${device_address_xml}
  </source>
</hostdev>
EOF
}

function enter_to_exit() {
    local rc=$?
    echo "Press ENTER to exit." >&2
    read -r -t 30 ||:
    exit $rc
}

if [[ -t 2 ]]; then
    COLOR_CLEAR="\033[0m"
    COLOR_GREEN="\033[32m"
    COLOR_CYAN="\033[36m"
else
    COLOR_CLEAR=""
    COLOR_GREEN=""
    COLOR_CYAN=""
fi

for domain in "${domains[@]}"; do
    if "${virsh[@]}" dumpxml "$domain" | xmllint --xpath "$device_xpath" - >/dev/null 2>&1; then
        printf "Detach ${COLOR_GREEN}%s${COLOR_CLEAR} from ${COLOR_CYAN}%s${COLOR_CLEAR}? [Y/n]" "$device_desc" "$domain" >&2
        read -r answer || {
            printf "\nCould not read answer from stdin.\n" >&2
            exit 1
        }

        if ! [[ "$answer" =~ ^[Nn] ]]; then
            virsh_command detach "$domain" || enter_to_exit
        fi
    fi
done

if [[ "$command" == attach ]]; then
    domain="$(printf '%s\n' "${domains[@]}" | fzf --header="Attach ${device_desc} to ..." --no-multi --no-sort --tac)"

    if [[ "$manufacturer" == *Yubi* ]]; then
        echo "Yubikey must be released by ssh-agent, gpg-agent, scdaemon and pcscd ..." >&2
        killall ssh-agent gpg-agent scdaemon ||:
        if systemctl is-active pcscd >/dev/null 2>&1; then
            sudo systemctl stop pcscd ||:
        fi
    fi

    printf "Attach ${COLOR_GREEN}%s${COLOR_CLEAR} to ${COLOR_CYAN}%s${COLOR_CLEAR} ...\n" "$device_desc" "$domain" >&2
    virsh_command attach "$domain" || enter_to_exit
fi
