# shellcheck shell=bash

shopt -s checkwinsize

function _bash_prompt_init() {
    PS1="\[\033[{{ 31 if ansible_facts.virtualization_role != "guest"
    else 32 if "workstations" in group_names
    else 35 if ansible_facts.virtualization_type == "container"
    else 36 }}m\]"
    if [[ "$UID" -eq 0 ]]; then
        PS1="${PS1}\[\033[7m\]"
    fi

    PS1="${PS1}\u@\h\[\033[0m\]:\[\033[34m\]\W\[\033[0m\]\${PS1_PROMPT@P} "
}

{% raw %}
function _bash_prompt_git_ref() {
    local git_ref

    git_ref="$(git symbolic-ref --short HEAD 2>/dev/null || git rev-parse --short HEAD)"
    # Prevent re-expansion in PS1_PROMPT@P; git refs forbid \
    git_ref="${git_ref//'$'/\\\\'$'}"
    git_ref="${git_ref//'`'/\\'`'}"
    printf '%s' "$git_ref"
}

function _bash_prompt_command() {
    PS1_RC=$?

    if [[ "$UID" -eq 0 ]]; then
        PS1_PROMPT='#'
    else
        PS1_PROMPT='$'
    fi

    if [[ "$PS1_RC" -ne 0 ]]; then
        PS1_PROMPT="\[\033[31m\]${PS1_PROMPT}\[\033[0m\]"
    fi

    if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        PS1_PROMPT="@\[\033[33m\]$(_bash_prompt_git_ref)\[\033[0m\]${PS1_PROMPT}"
    fi

    # shellcheck disable=SC2016 # single quotes
    if [[ "$PS1" != *'${PS1_PROMPT@P}'* ]]; then
        _bash_prompt_init
    fi
}

function _prompt_window_title() {
    local user="${USER:-$UID}"
    local host="${HOSTNAME%%.*}"

    printf '\e]2;%s@%s:%s\a' "${user//[[:cntrl:]]/}" "${host//[[:cntrl:]]/}" "${PWD//[[:cntrl:]]/}"
}

if [[ "$(declare -p PROMPT_COMMAND 2>&1)" != "declare -a"* ]]; then
    if [[ -n "${PROMPT_COMMAND-}" ]]; then
        PROMPT_COMMAND=("$PROMPT_COMMAND")
    else
        PROMPT_COMMAND=()
    fi
fi

function _add_prompt_command() {
    local func
    local item

    for func; do
        for item in "${PROMPT_COMMAND[@]}"; do
            if [[ "$item" == "$func" ]]; then
                continue 2
            fi
        done
        PROMPT_COMMAND+=("$func")
    done
}

_add_prompt_command _bash_prompt_command _prompt_window_title
_bash_prompt_init
{% endraw %}
